{
  "opencollection": "1.0.0",
  "info": {
    "name": "Tavily Web Crawl Search API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Web search",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.tavily.com/search"
          },
          "docs": "Run a real-time web search query."
        }
      ]
    }
  ],
  "bundled": true
}